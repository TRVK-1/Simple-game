<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Click Game</title>
  <style>
    body {
      text-align: center;
      font-family: Arial;
    }
    #box {
      width: 100px;
      height: 100px;
      background: red;
      position: absolute;
      top: 100px;
      left: 100px;
      cursor: pointer;
    }
  </style>
</head>
<body>

<h1>Score: <span id="score">0</span></h1>
<div id="box"></div>

<script>
  let score = 0;
  const box = document.getElementById("box");
  const scoreText = document.getElementById("score");

  function moveBox() {
    let x = Math.random() * (window.innerWidth - 100);
    let y = Math.random() * (window.innerHeight - 100);
    box.style.left = x + "px";
    box.style.top = y + "px";
  }

  box.onclick = function() {
    score++;
    scoreText.textContent = score;
    moveBox();
  };
</script>

</body>
</html>
